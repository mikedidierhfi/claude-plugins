{
  "_comment": "Ordered fallback lists of XBRL concepts for each line item. Resolver tries each in order and uses the first that has a value for the target period. 'taxonomy' is the namespace in companyfacts ('us-gaap' or 'dei'). 'kind' = instant (balance/point-in-time) or duration (flow/period). 'unit' hints the expected unit key.",
  "shares_outstanding": {
    "kind": "instant", "unit": "shares",
    "tags": [
      {"taxonomy": "dei", "tag": "EntityCommonStockSharesOutstanding"},
      {"taxonomy": "us-gaap", "tag": "CommonStockSharesOutstanding"},
      {"taxonomy": "us-gaap", "tag": "CommonStockSharesIssued"}
    ]
  },
  "long_term_debt_noncurrent": {
    "_note": "Totals first (used when present); then specific debt concepts for filers that only tag components (secured / convertible / related-party / notes). Debt under a company's OWN extension namespace is invisible to companyfacts for any filer — the liabilities-reconciliation flag + the 10-Q balance-sheet reader (verify_filing.py) catch those residuals.",
    "kind": "instant", "unit": "USD",
    "tags": [
      {"taxonomy": "us-gaap", "tag": "LongTermDebtNoncurrent"},
      {"taxonomy": "us-gaap", "tag": "LongTermDebtAndCapitalLeaseObligations"},
      {"taxonomy": "us-gaap", "tag": "LongTermDebt"},
      {"taxonomy": "us-gaap", "tag": "SecuredLongTermDebt"},
      {"taxonomy": "us-gaap", "tag": "ConvertibleDebtNoncurrent"},
      {"taxonomy": "us-gaap", "tag": "ConvertibleLongTermNotesPayable"},
      {"taxonomy": "us-gaap", "tag": "NotesPayableRelatedPartiesNoncurrent"},
      {"taxonomy": "us-gaap", "tag": "DueToRelatedPartiesNoncurrent"},
      {"taxonomy": "us-gaap", "tag": "LongTermNotesPayable"},
      {"taxonomy": "us-gaap", "tag": "SeniorLongTermNotes"},
      {"taxonomy": "us-gaap", "tag": "UnsecuredLongTermDebt"},
      {"taxonomy": "us-gaap", "tag": "LongTermLoansPayable"},
      {"taxonomy": "us-gaap", "tag": "OtherLongTermDebtNoncurrent"}
    ]
  },
